<?xml version="1.0" encoding="utf-8"?><!--
  Wrapped in a NestedScrollView on purpose.

  A bottom sheet gets whatever height the window has left, and in landscape on
  a tablet that is roughly half of 800dp. This menu is taller than that, so
  without a scrolling container the lower buttons were simply clipped away with
  nothing on screen to say so - and "Panel settings", which is where the admin
  PIN and the dedicated-panel lock live, was one of them. An installer holding
  a wall-mounted tablet in landscape could not reach the lockdown setup at all.

  NestedScrollView (not ScrollView) because BottomSheetBehavior cooperates with
  nested scrolling: the sheet drags when the content is already at its top, and
  the content scrolls otherwise. showAdminSheet() also opens the sheet expanded
  rather than at peek height, so on most screens there is nothing to scroll.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="24dp"
    android:paddingBottom="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/admin_sheet_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/change_server"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:minHeight="56dp"
        android:text="@string/admin_change_server" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/kiosk_settings"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="56dp"
        android:text="@string/admin_kiosk_settings" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/view_fingerprint"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="56dp"
        android:text="@string/admin_view_fingerprint" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/close_app"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="56dp"
        android:text="@string/admin_close_app" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/close_sheet"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/admin_close" />

</LinearLayout>

</androidx.core.widget.NestedScrollView>
