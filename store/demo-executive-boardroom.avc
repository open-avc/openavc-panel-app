{
  "openavc_version": "0.13.0",
  "project": {
    "id": "demo_boardroom",
    "name": "Executive Boardroom",
    "description": "Store listing demo space",
    "created": "2026-09-12T00:00:00",
    "modified": "2026-09-12T00:00:00"
  },
  "devices": [],
  "connections": {},
  "driver_dependencies": [],
  "device_groups": [],
  "variables": [
    {
      "id": "current_source",
      "type": "string",
      "default": "laptop",
      "label": "Source"
    },
    {
      "id": "display_power",
      "type": "string",
      "default": "on",
      "label": "Display power"
    },
    {
      "id": "volume",
      "type": "integer",
      "default": 62,
      "label": "Volume"
    },
    {
      "id": "mute",
      "type": "boolean",
      "default": false,
      "label": "Mute"
    },
    {
      "id": "mic_mute",
      "type": "boolean",
      "default": false,
      "label": "Mic mute"
    },
    {
      "id": "lighting",
      "type": "string",
      "default": "present",
      "label": "Lighting"
    },
    {
      "id": "shades",
      "type": "string",
      "default": "closed",
      "label": "Shades"
    }
  ],
  "macros": [
    {
      "id": "shutdown",
      "name": "Shut down space",
      "steps": [
        {
          "action": "state.set",
          "key": "var.display_power",
          "value": "off"
        },
        {
          "action": "state.set",
          "key": "var.lighting",
          "value": "off"
        },
        {
          "action": "state.set",
          "key": "var.shades",
          "value": "open"
        },
        {
          "action": "state.set",
          "key": "var.mute",
          "value": true
        }
      ]
    },
    {
      "id": "help",
      "name": "Request help",
      "steps": [
        {
          "action": "help.request",
          "message": "Executive Boardroom needs a hand"
        }
      ]
    }
  ],
  "scripts": [],
  "plugins": {},
  "plugin_dependencies": [],
  "isc": {
    "shared_state": [],
    "auth_key": ""
  },
  "ui": {
    "settings": {
      "theme": "dark",
      "theme_id": "slate",
      "theme_overrides": {
        "panel_bg": "#080b0e",
        "panel_text": "#e4eae6",
        "accent": "#8AB493",
        "button_bg": "#232e38",
        "button_text": "#e4eae6",
        "button_border": "#34424e",
        "surface": "#1a232b",
        "surface_border": "#2c3843",
        "border_radius": 0.7143
      },
      "element_entry": "none",
      "show_error_messages": true
    },
    "custom_css": ".vol-fader .fader-track { width: 0.8571rem; background: #2b3641; border-color: #3a4753; }",
    "pages": [
      {
        "id": "main",
        "name": "Main",
        "page_type": "page",
        "elements": [
          {
            "id": "logo",
            "type": "image",
            "src": "assets://openavc-logo-wide.png",
            "object_fit": "contain",
            "style": {
              "bg_color": "transparent",
              "border_width": 0
            }
          },
          {
            "id": "space_name",
            "type": "label",
            "text": "Executive Boardroom",
            "style": {
              "font_size": 2.7,
              "text_align": "left",
              "text_color": "#e4eae6",
              "letter_spacing": 0.02
