          },
          {
            "id": "src_laptop",
            "type": "button",
            "label": "Laptop",
            "icon": "laptop",
            "icon_position": "left",
            "icon_size": 2.4,
            "display_mode": "icon_text",
            "style": {
              "font_size": 1.7,
              "text_align": "left",
              "padding_horizontal": 1.4,
              "letter_spacing": 0.02
            },
            "bindings": {
              "show": {
                "look": {
                  "source": "state",
                  "key": "var.current_source",
                  "condition": {
                    "equals": "laptop"
                  },
                  "style_active": {
                    "bg_color": "#8AB493",
                    "text_color": "#0b1210",
                    "border_color": "#8AB493",
                    "icon_color": "#0b1210"
                  },
                  "style_inactive": {
                    "bg_color": "#232e38",
                    "text_color": "#e4eae6",
                    "border_color": "#34424e",
                    "icon_color": "#7EB6D9"
                  }
                }
              },
              "do": {
                "press": [
                  {
                    "action": "state.set",
                    "key": "var.current_source",
                    "value": "laptop"
                  }
                ]
